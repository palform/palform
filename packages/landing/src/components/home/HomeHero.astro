---
import HeroContent from "../hero/HeroContent.astro";
import HeroHeader from "../hero/HeroHeader.astro";
import HeroParagraph from "../hero/HeroParagraph.astro";
import HeroTitle from "../hero/HeroTitle.astro";
import HeroButtons from "../hero/HeroButtons.astro";
import HeroIframe from "../hero/HeroIframe.astro";
import HomeTrustedBy from "./HomeTrustedBy.astro";
---

<HeroHeader>
    <HeroContent class="md:max-w-[50%]">
        <HeroTitle>
            Forms only
            <span
                class="underline decoration-primary-200 dark:decoration-primary-700"
            >
                you
            </span>
            can read
        </HeroTitle>
        <HeroParagraph>
            Every response is end-to-end encrypted before it leaves the browser.
            Build and share a beautiful form in five minutes. Start for free,
            with unlimited responses.
        </HeroParagraph>

        <HomeTrustedBy />

        <HeroButtons />
    </HeroContent>
    <HeroContent class="flex-1 justify-end relative md:flex hidden">
        <HeroIframe
            url="https://dash.palform.app/fill/org_0GYDWW6VM4C0E/form_0H6KNG7R9X8N5?f=fat_0H6KNK8BSXFKE"
        />
    </HeroContent>
</HeroHeader>
