import ComparisonTableRow from "./ComparisonTableRow.astro";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div class="overflow-y-auto">
    <div
        class={`w-full min-w-[500px] px-6 border border-slate-300 dark:border-slate-600 rounded-2xl ${className}`}
    >
        <ComparisonTableRow>
            <ComparisonTableCol />
            <ComparisonTableCol center large><LogoType /></ComparisonTableCol>
            <ComparisonTableCol center large>Typeform</ComparisonTableCol>
            <ComparisonTableCol center large>Jotform</ComparisonTableCol>
            <ComparisonTableCol center large>Google Forms</ComparisonTableCol>
        </ComparisonTableRow>
        <ComparisonTableRow>
            <ComparisonTableCol>
                <em>True</em> end-to-end encryption
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={true} />
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={false} />
            </ComparisonTableCol>
            <ComparisonTableCol center> Optional </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={false} />
            </ComparisonTableCol>
        </ComparisonTableRow>
        <ComparisonTableRow>
            <ComparisonTableCol>
                Unlimited responses for free
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={true} />
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={false} />
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={false} />
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={true} />
            </ComparisonTableCol>
        </ComparisonTableRow>
        <ComparisonTableRow>
            <ComparisonTableCol> Friendly human support </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={true} />
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={true} />
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={true} />
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={false} />
            </ComparisonTableCol>
        </ComparisonTableRow>
        <ComparisonTableRow>
            <ComparisonTableCol>Generous free plan</ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={true} />
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={false} />
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={false} />
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={true} />
            </ComparisonTableCol>
        </ComparisonTableRow>
        <ComparisonTableRow>
            <ComparisonTableCol>Hosted exclusively in the EU</ComparisonTableCol
            >
            <ComparisonTableCol center large>
                <ComparisonTableMark check={true} />
            </ComparisonTableCol>
            <ComparisonTableCol center>Enterprise only</ComparisonTableCol>
            <ComparisonTableCol center>Optional</ComparisonTableCol>
            <ComparisonTableCol center> Enterprise only </ComparisonTableCol>
        </ComparisonTableRow>
        <ComparisonTableRow>
            <ComparisonTableCol>
                Affordable enterprise-grade user management
            </ComparisonTableCol>
            <ComparisonTableCol center large>
                <ComparisonTableMark check={true} />
            </ComparisonTableCol>
            <ComparisonTableCol center>
                Enterprise plan only
            </ComparisonTableCol>
            <ComparisonTableCol center>
                Enterprise plan only
            </ComparisonTableCol>
            <ComparisonTableCol center>
                Google Workspace only
            </ComparisonTableCol>
        </ComparisonTableRow>
