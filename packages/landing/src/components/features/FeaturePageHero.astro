---
import HeroContent from "../hero/HeroContent.astro";
import HeroHeader from "../hero/HeroHeader.astro";
import HeroParagraph from "../hero/HeroParagraph.astro";
import HeroTitle from "../hero/HeroTitle.astro";
import HeroButtons from "../hero/HeroButtons.astro";
import HomeTrustedBy from "../home/HomeTrustedBy.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;
---

<HeroHeader>
    <HeroContent class="md:max-w-[60%]">
        <HeroTitle>
            {title}
        </HeroTitle>

        {description && <HeroParagraph>{description}</HeroParagraph>}

        <HomeTrustedBy />

        <HeroButtons />
    </HeroContent>
    <slot />
</HeroHeader>
