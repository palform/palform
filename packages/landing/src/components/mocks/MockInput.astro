---
import MockText from "./MockText.astro";

interface Props {
    long?: boolean;
    label?: string;
    value?: string;
    class?: string;
}

const { long, label, value, class: className } = Astro.props;
const Element = long ? "textarea" : "input";
---

{label && <MockText class="mb-1">{label}</MockText>}

<Element
    class:list={[
        "block w-full bg-transparent border dark:border-slate-700 dark:text-gray-300 px-4 resize-none rounded-lg min-h-10",
        className,
    ]}
    value={Element === "input" ? value : undefined}
>
    {Element === "textarea" ? value : undefined}
</Element>
