---
interface Props {
    darker?: boolean;
    class?: string;
}

const { darker, class: className } = Astro.props;
---

<p
    class:list={[
        darker
            ? "text-gray-700 dark:text-gray-200"
            : "text-gray-500 dark:text-gray-400",
        className,
    ]}
>
    <slot />
</p>
