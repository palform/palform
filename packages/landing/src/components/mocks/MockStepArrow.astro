---
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div
    class:list={[
        "ml-4 border-dotted border-l-2 border-l-primary-400 dark:border-l-primary-600 py-4",
        className,
    ]}
>
    <p class="inline-block ml-4 text-gray-600 dark:text-gray-400">
        <slot />
    </p>
</div>
