---
// @ts-ignore
import "@fontsource-variable/archivo";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import DarkModeWatcher from "@palform/palform-frontend-common/src/darkMode/DarkModeWatcher.svelte";

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content={description ??
				"Build end-to-end encrypted forms with advanced enterprise-grade features in just a few simple clicks; no coding required."}
		/>
		<meta name="viewport" content="width=device-width" />
		<slot name="canonical">
			<link rel="canonical" href={Astro.url} />
		</slot>
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<script
			defer
			data-domain="palform.app"
			src="https://plausible.io/js/script.tagged-events.js"
			is:inline></script>

		<!-- Makes sure we don't have any non-dark-mode moment during page load -->
		<script is:inline>
			if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
				window.document.documentElement.classList.add("dark");
			}
		</script>

		<title>{title} &mdash; Palform</title>
	</head>
	<body class="bg-slate-50/50 dark:bg-slate-900">
		<slot />
		<Footer />
		<DarkModeWatcher client:only="svelte" />
	</body>
</html>
