{
  "extends": [
    "astro/tsconfigs/strict",
    "@tsconfig/svelte/tsconfig.json"
  ],
  "exclude": [
    "dist"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "src/**/*.astro",
    ".astro/types.d.ts",
    "./worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "plugins": [
      {
        "name": "typescript-svelte-plugin",
        "enabled": true,
        "assumeIsSvelteProject": true
      }
    ]
  }
}